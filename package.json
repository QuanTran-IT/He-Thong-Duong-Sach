{
  "name": "duong-sach-tphcm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:admin": "npm --prefix admin run dev",
    "dev:server": "node --watch server/index.js",
    "build": "node ./node_modules/vite/bin/vite.js build --config client/vite.config.js",
    "build:admin": "npm --prefix admin run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.2",
    "vite": "^7.1.3"
  }
}
